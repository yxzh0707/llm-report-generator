# Copy to .env.local, or select a profile with DISSERTATION_ENV_FILE.
# Never commit API keys. The referenced private file may use another key name.
DISSERTATION_PROVIDER=vllm
DISSERTATION_MODEL=Qwen3.8-27B
ROLLOUT_BASE_URL=
DISSERTATION_CREDENTIALS_FILE=
DISSERTATION_CREDENTIALS_KEY=VLLM_API_KEY
DISSERTATION_THINKING=false
DISSERTATION_TOOL_ENV_FILE=
DISSERTATION_EMBEDDING_ENV_FILE=
# Alternatively inject DISSERTATION_API_KEY or TOKENHUB_API_KEY in the process.
TOKENHUB_API_KEY=
SERPER_API_KEY=
SEC_USER_AGENT=
ALPHA_VANTAGE_API_KEY=
TUSHARE_TOKEN=
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_API_KEY=
JUDGE_PROVIDER=tokenhub_openai
JUDGE_MODEL=bailian/deepseek-v4-flash-0731
JUDGE_CREDENTIALS_FILE=
JUDGE_CREDENTIALS_KEY=ANTHROPIC_API_KEY
JUDGE_THINKING=false

# Path to an independently obtained authorised Hermes checkout
HERMES_SOURCE=
